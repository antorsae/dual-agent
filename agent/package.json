{
  "name": "codex-delegate",
  "version": "0.3.0",
  "description": "Bidirectional Claude, Codex, and Rosalind delegation with persistent jobs",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "codex-delegate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "claude-mcp": "node dist/claudeMcp.js",
    "rosalind-mcp": "node dist/rosalindMcp.js",
    "rosalind-codex-mcp": "node dist/rosalindCodexMcp.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
